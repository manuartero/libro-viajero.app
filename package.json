{
  "name": "libro-viajero.app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "packageManager": "pnpm@11.1.2",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "lint": "biome check .",
    "format": "biome format --write .",
    "blue-ball": "pnpm lint && pnpm test && pnpm build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/manuartero/libro-viajero.app.git"
  },
  "author": "Manuel Artero <manutero.developer@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/manuartero/libro-viajero.app/issues"
  },
  "homepage": "https://github.com/manuartero/libro-viajero.app#readme",
  "dependencies": {
    "@fontsource/besley": "^5.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@testing-library/react": "16.3.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "jsdom": "29.1.1",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
